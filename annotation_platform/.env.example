APP_ENV=production
DEBUG=
SECRET_KEY=

DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSLMODE=require

ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_SIGNATURE_VERSION=

# Set to local to store uploads under MEDIA_ROOT instead of S3.
STORAGE_BACKEND=s3
MEDIA_ROOT=
MEDIA_URL=/media/
LOCAL_MEDIA_BASE_URL=http://localhost:8000/media/

# Maximum DICOM SEG request size. Defaults to 256 MiB.
SEGMENTATION_MAX_UPLOAD_BYTES=

SESSION_COOKIE_SAMESITE=
SESSION_COOKIE_SECURE=

CSRF_COOKIE_SAMESITE=
CSRF_COOKIE_SECURE=
